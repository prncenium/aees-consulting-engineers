# SMTP credentials for the contact form (GoDaddy Workspace Email).
# The mailbox lives on secureserver, not Titan — the domain's MX records point
# at smtp/mailstore1.secureserver.net, and smtp.titan.email rejects the login.
# Copy to .env.local for local dev and add the same keys in Vercel →
# Project → Settings → Environment Variables. Never commit real values.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@aeesconsulting.in
SMTP_PASS=tempmeowmeow123
MAIL_TO=info@aeesconsulting.in
